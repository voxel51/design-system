{
  "name": "@voxel51/voodo",
  "version": "0.0.1",
  "description": "Voxel51's official design ontology (VOODO) system",
  "type": "module",
  "author": "Voxel Engineering <engineering@voxel51.com>",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "https://github.com/voxel51/ux-common.git"
  },
  "publishConfig": {
    "registry": "https://us-central1-npm.pkg.dev/computer-vision-team/dev-js/"
  },
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "require": "./dist/index.cjs",
      "types": "./dist/index.d.ts"
    },
    "./theme.css": "./dist/voodo.css"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "dev": "vite build --watch",
    "build": "tsc && vite build",
    "build:lib": "npm run prepublish && mkdir -p build/lib && npm pack --pack-destination build/lib/",
    "format": "prettier --write '**/*.{ts,tsx}'",
    "generate-tailwind-theme": "tsx utils/generate-tailwind-theme.ts",
    "patch": "npm version --commit-hooks false --git-tag-version false patch",
    "prebuild": "npm run generate-tailwind-theme",
    "prepublishOnly": "npm run build",
    "test": "jest"
  },
  "dependencies": {
    "@headlessui/react": "^2.2.9",
    "clsx": "^2.1.1"
  },
  "devDependencies": {
    "@mui/material": "^5.0.0",
    "@mui/utils": "^5.0.0",
    "@tailwindcss/postcss": "^4.1.17",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.0",
    "@testing-library/user-event": "^14.6.1",
    "@tsconfig/recommended": "^1.0.7",
    "@types/jest": "^29.5.14",
    "@types/node": "^22.7.4",
    "@types/react": "^19.2.7",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^5.1.1",
    "autoprefixer": "^10.4.22",
    "jest": "^29.7.0",
    "jest-environment-jsdom": "^30.2.0",
    "postcss": "^8.5.6",
    "prettier": "^3.6.2",
    "react": "^18.0.0",
    "react-dom": "^18.0.0",
    "react-is": "^18.0.0",
    "tailwindcss": "^4.1.17",
    "ts-jest": "^29.2.5",
    "ts-node": "^10.9.2",
    "tsx": "^4.20.6",
    "typescript": "^5.6.2",
    "vite": "^7.1.7",
    "vite-plugin-dts": "^4.5.4"
  },
  "peerDependencies": {
    "@emotion/react": "^11.0.0",
    "@emotion/styled": "^11.0.0",
    "react": "^18.0.0",
    "react-dom": "^18.0.0",
    "react-is": "^18.0.0"
  }
}
